rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.active == true;
    }

    function isPublicAgencyRequester() {
      return request.auth == null
        || request.auth.token.firebase.sign_in_provider == 'anonymous'
        || isAdmin();
    }

    match /adminUsers/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow list: if false;
      allow update: if false;
      allow create, delete: if false;
    }

    match /travelerUsers/{uid} {
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.keys().hasAll(['ownerUid', 'displayName', 'email', 'createdAt', 'updatedAt'])
                    && request.resource.data.keys().hasOnly(['ownerUid', 'displayName', 'email', 'phone', 'createdAt', 'updatedAt']);
      allow read: if request.auth != null
                  && request.auth.uid == uid
                  && request.auth.token.firebase.sign_in_provider != 'anonymous'
                  || isAdmin();
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phone', 'updatedAt'])
                    || isAdmin() && false;
      allow delete: if false;
    }

    match /travelerRequests/{requestId} {
      allow create: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.status == 'submitted'
                    && request.resource.data.assignee == null
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.keys().hasAll([
                      'ownerUid', 'travelerName', 'contactPhone',
                      'region', 'startDate', 'endDate',
                      'partySize', 'language', 'requestDetails',
                      'status', 'assignee', 'createdAt'
                    ])
                    && request.resource.data.keys().hasOnly([
                      'ownerUid', 'travelerName', 'contactPhone',
                      'selectedGuideId', 'selectedGuideName',
                      'region', 'startDate', 'endDate',
                      'partySize', 'language', 'requestDetails',
                      'status', 'assignee', 'createdAt', 'updatedAt'
                    ]);
      allow read: if request.auth != null
                  && request.auth.token.firebase.sign_in_provider != 'anonymous'
                  && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'status',
                      'assignee',
                      'updatedAt'
                    ])
                    && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
    }

    match /agencyRequests/{requestId} {
      allow create: if isPublicAgencyRequester()
                    && request.resource.data.keys().hasAll([
                      'companyName', 'contactName', 'contactPhone', 'contactEmail',
                      'preferredContactMethod', 'companyDescription',
                      'eventName', 'eventType', 'region', 'startDate', 'endDate',
                      'participantCount', 'guideCount', 'languages', 'customLanguage',
                      'taskDescription', 'certificatePriority', 'sourcingExperience',
                      'urgency', 'preferredExperience', 'similarEventExperience',
                      'drivingRequired', 'budget', 'additionalNotes',
                      'privacyConsent', 'contactConsent',
                      'status', 'assignee', 'createdAt',
                      'preferredGuideId', 'preferredGuideName'
                    ])
                    && request.resource.data.keys().hasOnly([
                      'companyName', 'contactName', 'contactPhone', 'contactEmail',
                      'preferredContactMethod', 'companyDescription',
                      'eventName', 'eventType', 'region', 'startDate', 'endDate',
                      'participantCount', 'guideCount', 'languages', 'customLanguage',
                      'taskDescription', 'certificatePriority', 'sourcingExperience',
                      'urgency', 'preferredExperience', 'similarEventExperience',
                      'drivingRequired', 'budget', 'additionalNotes',
                      'privacyConsent', 'contactConsent',
                      'status', 'assignee', 'createdAt',
                      'preferredGuideId', 'preferredGuideName'
                    ])
                    && request.resource.data.status == 'submitted'
                    && request.resource.data.assignee == null
                    && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'status',
                      'assignee',
                      'updatedAt'
                    ]);
      allow delete: if false;
    }

    match /guideProfiles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid
                  || isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.profileStatus == "pending"
                    && request.resource.data.keys().hasAll(["createdAt", "updatedAt"]);
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      "profileStatus",
                      "updatedAt"
                    ]);
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.profileStatus == resource.data.profileStatus
                    && request.resource.data.keys().hasOnly([
                      "ownerUid", "name", "languages", "regions",
                      "experienceRange", "introduction", "profilePhotoUrl",
                      "profileStatus", "createdAt", "updatedAt"
                    ]);
      allow delete: if false;
    }

    match /guideRegistrations/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid
                  || isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.verificationStatus == "pending";
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      "verificationStatus",
                      "updatedAt"
                    ]);
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.submittedAt == resource.data.submittedAt
                    && request.resource.data.verificationStatus == resource.data.verificationStatus
                    && request.resource.data.keys().hasOnly([
                      "ownerUid", "phone", "certificateLanguage", "certificateNumber",
                      "certificateFilePath", "resumeFilePath", "privacyConsent",
                      "verificationStatus", "submittedAt", "updatedAt"
                    ]);
      allow delete: if false;
    }

    match /guideVerificationReviews/{uid} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /guideVerificationLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /publicGuideProfiles/{uid} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /platformAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /guideMarketReferences/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /jobs/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
