rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /guideProfiles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.profileStatus == "pending"
                    && request.resource.data.keys().hasAll(["createdAt", "updatedAt"]);
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.profileStatus == resource.data.profileStatus;
      allow delete: if false;
    }

    match /guideRegistrations/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.verificationStatus == "pending";
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.submittedAt == resource.data.submittedAt
                    && request.resource.data.verificationStatus == resource.data.verificationStatus;
      allow delete: if false;
    }

    match /guideMarketReferences/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /jobs/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
